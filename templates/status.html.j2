<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Equal-weight vs cap-weight S&amp;P 500</title>
<meta name="description" content="Where the equal-weight S&amp;P 500 (RSP) stands against the cap-weighted S&amp;P 500 (SPY) on twelve-month total return, the full history since 2004, and what a rule built on it did over a century.">
<style>
  :root{
    color-scheme: light;
    --plane:#f9f9f7; --surface:#fcfcfb; --ink:#0b0b0b; --ink-2:#52514e;
    --muted:#898781; --grid:#e1e0d9; --axis:#c3c2b7;
    --up:#2a78d6; --down:#e34948; --neutral:#f0efec;
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      color-scheme: dark;
      --plane:#0d0d0d; --surface:#1a1a19; --ink:#ffffff; --ink-2:#c3c2b7;
      --muted:#898781; --grid:#2c2c2a; --axis:#383835;
      --up:#3987e5; --down:#e66767; --neutral:#383835;
    }
  }
  :root[data-theme="dark"]{
    color-scheme: dark;
    --plane:#0d0d0d; --surface:#1a1a19; --ink:#ffffff; --ink-2:#c3c2b7;
    --muted:#898781; --grid:#2c2c2a; --axis:#383835;
    --up:#3987e5; --down:#e66767; --neutral:#383835;
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--plane);color:var(--ink);
    font:16px/1.6 ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;}
  .wrap{max-width:900px;margin:0 auto;padding:40px 16px 72px}
  h1{font-size:1.7rem;line-height:1.25;margin:0 0 .4rem;letter-spacing:-.01em}
  h2{font-size:1.1rem;margin:2.6rem 0 .7rem;letter-spacing:-.005em}
  p{margin:0 0 1rem;color:var(--ink-2)}
  .lede{font-size:1.02rem;color:var(--ink-2);max-width:62ch}
  .card{background:var(--surface);border:1px solid var(--grid);border-radius:12px;padding:20px}
  .reading{display:flex;flex-wrap:wrap;gap:8px 32px;align-items:baseline;margin:22px 0 6px}
  .big{font-size:2.6rem;font-weight:650;letter-spacing:-.02em;line-height:1.05;
    font-variant-numeric:tabular-nums}
  .big.up{color:var(--up)} .big.down{color:var(--down)}
  .sub{color:var(--ink-2);font-size:.95rem;max-width:56ch}
  .asof{color:var(--muted);font-size:.85rem;margin-top:2px}
  figure{margin:0}
  svg{display:block;width:100%;height:auto;touch-action:pan-y}
  .legend{display:flex;gap:18px;flex-wrap:wrap;margin:10px 2px 0;
    font-size:.85rem;color:var(--ink-2)}
  .key{display:inline-flex;align-items:center;gap:7px}
  .dot{width:11px;height:11px;border-radius:3px;flex:none}
  table{border-collapse:collapse;width:100%;font-size:.9rem;
    font-variant-numeric:tabular-nums}
  th,td{text-align:left;padding:7px 10px;border-bottom:1px solid var(--grid)}
  th{color:var(--muted);font-weight:600;font-size:.78rem;letter-spacing:.04em;
    text-transform:uppercase}
  td.num{text-align:right}
  .pos{color:var(--up)} .neg{color:var(--down)}
  .bar{display:inline-block;height:9px;border-radius:3px;vertical-align:middle}
  details{margin-top:12px}
  summary{cursor:pointer;color:var(--ink-2);font-size:.9rem}
  .scroll{max-height:420px;overflow:auto;margin-top:12px;border:1px solid var(--grid);
    border-radius:10px}
  .note{font-size:.88rem;color:var(--muted);border-top:1px solid var(--grid);
    margin-top:44px;padding-top:18px}
  .note p{color:var(--muted)}
  #tip{position:fixed;pointer-events:none;opacity:0;transition:opacity .08s;
    background:var(--surface);border:1px solid var(--axis);border-radius:8px;
    padding:7px 10px;font-size:.82rem;color:var(--ink);white-space:nowrap;
    box-shadow:0 4px 14px rgba(0,0,0,.14);font-variant-numeric:tabular-nums;z-index:9}
  @media (max-width:560px){ .big{font-size:2.1rem} .wrap{padding:28px 16px 56px} }
</style>
</head>
<body>
<div class="wrap">

  <h1>Equal-weight vs cap-weight S&amp;P 500</h1>
  <p class="lede">
    The same five hundred companies can be held two ways: weighted by company size,
    which is what the S&amp;P 500 ({{ cap }}) does, or weighted equally, which is what
    {{ equal }} does. This page tracks the gap between them and shows what a rule
    built on that gap has done over a century. It describes a measurement. It does
    not suggest a position.
  </p>

  <div class="card">
    <div class="reading">
      <div class="big {{ 'up' if gap > 0 else 'down' }}">{{ gap | pct }}</div>
      <div class="sub">
        Over the twelve months to the <strong>{{ month }}</strong> close,
        {{ equal }} returned {{ gap | pct }} against {{ cap }} —
        {{ ahead }} ahead.
        {% if live %}
        <div class="asof">
          Running gap on the latest daily close ({{ live.asof }}):
          <strong style="color:var({{ '--up' if live.gap > 0 else '--down' }})">{{ live.gap | pct }}</strong>
          &mdash; provisional, the month is not finished and the rule reads
          month-end closes only.
        </div>
        {% endif %}
        <div class="asof">Replayed from {{ months }} month-end closes since {{ since_first }}. Built {{ built }}.</div>
      </div>
    </div>
  </div>

  <h2>The gap, month by month</h2>
  <figure>
    <svg viewBox="0 0 {{ chart.w }} {{ chart.h }}" role="img"
         aria-label="Twelve-month return of {{ equal }} minus {{ cap }}, each month end since {{ since_first }}.">
      <defs>
        <clipPath id="above"><rect x="0" y="0" width="{{ chart.w }}" height="{{ chart.zero }}"/></clipPath>
        <clipPath id="below"><rect x="0" y="{{ chart.zero }}" width="{{ chart.w }}" height="{{ chart.h }}"/></clipPath>
      </defs>
      <rect x="{{ chart.x0 }}" y="{{ chart.band_top }}" width="{{ chart.x1 - chart.x0 }}"
            height="{{ (chart.band_bot - chart.band_top) | round(1) }}" fill="var(--neutral)"/>
      {% for t in chart.ylabs %}
      <line x1="{{ chart.x0 }}" y1="{{ t.y }}" x2="{{ chart.x1 }}" y2="{{ t.y }}"
            stroke="var(--grid)" stroke-width="1"/>
      <text x="{{ chart.x0 - 8 }}" y="{{ t.y + 4 }}" text-anchor="end"
            fill="var(--muted)" font-size="11">{{ t.label }}</text>
      {% endfor %}
      <path d="{{ chart.area }}" fill="var(--up)" fill-opacity=".16" clip-path="url(#above)"/>
      <path d="{{ chart.area }}" fill="var(--down)" fill-opacity=".16" clip-path="url(#below)"/>
      <path d="{{ chart.line }}" fill="none" stroke="var(--up)" stroke-width="2"
            stroke-linejoin="round" clip-path="url(#above)"/>
      <path d="{{ chart.line }}" fill="none" stroke="var(--down)" stroke-width="2"
            stroke-linejoin="round" clip-path="url(#below)"/>
      <line x1="{{ chart.x0 }}" y1="{{ chart.zero }}" x2="{{ chart.x1 }}" y2="{{ chart.zero }}"
            stroke="var(--axis)" stroke-width="1"/>
      {% for t in chart.ticks %}
      <text x="{{ t.x }}" y="{{ chart.h - 8 }}" text-anchor="middle"
            fill="var(--muted)" font-size="11">{{ t.label }}</text>
      {% endfor %}
      <g id="cross" opacity="0">
        <line y1="{{ chart.h - 26 }}" y2="14" stroke="var(--axis)" stroke-width="1"/>
        <circle r="4.5" fill="var(--surface)" stroke-width="2"/>
      </g>
      <rect id="hit" x="{{ chart.x0 }}" y="0" width="{{ chart.x1 - chart.x0 }}"
            height="{{ chart.h }}" fill="transparent"/>
    </svg>
    <div class="legend">
      <span class="key"><span class="dot" style="background:var(--up)"></span>{{ equal }} ahead over twelve months</span>
      <span class="key"><span class="dot" style="background:var(--down)"></span>{{ cap }} ahead</span>
      <span class="key"><span class="dot" style="background:var(--neutral);border:1px solid var(--axis)"></span>within {{ (band * 100) | round | int }} point of level</span>
    </div>
  </figure>

  <h2>What the rule is</h2>
  <p>
    A published rule reads that gap at each month-end and calls a state: equal-weight
    once the gap rises above +{{ (band * 100) | round | int }} point, cap-weight once
    it falls below &minus;{{ (band * 100) | round | int }}, unchanged in between. The
    band exists to stop the state flickering around zero: tested on 1990&ndash;2026 it
    cut the number of changes from 36 to 16 without changing the return.
  </p>
  <p>
    Over the {{ months }} months charted above the state has changed
    <strong>{{ n_flips }} times</strong>, and has
    read <strong>{{ equal if equal_ahead else cap }}</strong> for the last
    {{ held }} months, since {{ began }}.
  </p>

  <h2>Every change of state</h2>
  <div class="card" style="padding:4px 8px">
  <table>
    <thead><tr><th>Month</th><th>State becomes</th><th class="num">Gap that month</th></tr></thead>
    <tbody>
    {% for f in flips %}
      <tr><td>{{ f.month }}</td><td>{{ f.to }}</td>
        <td class="num {{ 'pos' if f.gap > 0 else 'neg' }}">{{ f.gap | pct }}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  </div>

  <h2>How it has played out</h2>
  <p>
    The rule's parameters were chosen on 1990&ndash;2026. Running it on 1927&ndash;1989,
    which nothing was fitted to, is the out-of-sample test. Over those sixty-three
    years a monthly contribution following the rule finished
    <strong>within a rounding error of holding cap-weight alone</strong>: ahead in
    <strong>44% of rolling ten-year windows</strong>, median <strong>&minus;1.4%</strong>.
    Across the whole century the difference is about +7% in total.
  </p>
  <p>
    That average hides the shape, which is the interesting part. The rule adds when the
    largest companies lag and gives it back when they lead:
  </p>
  <div class="card" style="padding:4px 8px">
  <table>
    <thead><tr><th>Decade</th><th>Largest companies</th><th class="num">Rule vs cap-weight</th><th style="width:38%"></th></tr></thead>
    <tbody>
      {% for d in decades %}
      <tr>
        <td>{{ d.name }}</td><td>{{ d.regime }}</td>
        <td class="num {{ 'pos' if d.v > 0 else 'neg' }}">{{ "%+.1f"|format(d.v) }} pts/yr</td>
        <td>
          <span class="bar" style="width:{{ (d.v | abs) * 26 }}px;
            background:var({{ '--up' if d.v > 0 else '--down' }});
            margin-left:{{ 42 if d.v > 0 else (42 - (d.v | abs) * 26) }}px"></span>
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
  <p style="margin-top:1rem">
    In the worst case on record it made no difference at all: through the 1929&ndash;1932
    collapse, cap-weight fell 84% and the rule fell 84%. Nothing about this shortens a
    crash &mdash; both sides of the switch are fully invested in equities at all times.
  </p>

  <h2>The same rule in a taxable account</h2>
  <p>
    Changing state means selling one fund and buying the other, which in a taxable
    account realises a gain each time. Measured over 1991&ndash;2026, doing that ended
    between <strong>&minus;4% and +5%</strong> against simply holding, before any state
    tax &mdash; the tax at each change consumed the difference. Directing only new
    contributions by the signal, without selling anything, finished behind. In a
    tax-advantaged account no tax falls at the change, and that is the whole of the
    difference between the two cases.
  </p>

  <h2>Where concentration stands</h2>
  <p>
    The gap above is a symptom of something measurable directly. Using Ken French's
    CRSP size portfolios, the largest decile of US companies held
    <strong>77.7% of total US market capitalisation</strong> as of July 2026 &mdash;
    the highest reading in the record, which begins in 1926. Previous peaks were 75% in
    1932, 73% in 2000 and 72% in 1940.
  </p>
  <p>
    Starting from the most concentrated fifth of all months since 1926, the following
    ten years returned <strong>+9.2% a year for the market as a whole</strong>,
    <strong>+7.9% for the largest decile</strong> and <strong>+11.9% for everything
    else</strong>. Those windows overlap heavily, so they represent a handful of
    episodes rather than hundreds of independent draws.
  </p>

  <details>
    <summary>Full history as a table ({{ months }} months)</summary>
    <div class="scroll">
      <table>
        <thead><tr><th>Month</th><th class="num">Gap</th><th>State</th></tr></thead>
        <tbody>
        {% for r in table %}
          <tr><td>{{ r.month }}</td>
            <td class="num {{ 'pos' if r.gap > 0 else 'neg' }}">{{ r.gap | pct }}</td>
            <td>{{ r.state }}</td></tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  </details>

  <div class="note">
    <p>
      <strong>Method.</strong> Daily adjusted closes for {{ cap }} and {{ equal }} from
      Tiingo, reduced to the last close of each completed month. The gap is
      {{ equal }}'s twelve-month total return minus {{ cap }}'s. State is replayed from
      the start of the series on every build, so the page is reproducible and stores
      nothing. The century figures come from Ken French's CRSP size portfolios, with an
      equal-weighted largest-30% portfolio standing in for {{ equal }} before 2003
      (chosen on signal agreement alone: 88% of months, gaps correlating 0.89).
      Source: <a href="https://github.com/lihtness/index-signal" style="color:var(--up)">github.com/lihtness/index-signal</a>.
    </p>
    <p>
      <strong>This is published research, not investment advice.</strong> The author is
      not an investment adviser and has no idea who you are, what you hold, or what your
      circumstances are. Nothing here is a recommendation to buy, sell or hold anything.
      Past measurements do not predict future results, and a rule whose out-of-sample
      record is a coin flip is presented here precisely so that it can be judged as one.
    </p>
  </div>
</div>

<div id="tip" role="status" aria-live="polite"></div>
<script>
(function(){
  var data = {{ series | tojson }};
  var pts  = {{ chart.points | tojson }};
  var svg  = document.querySelector('svg');
  var hit  = document.getElementById('hit');
  var g    = document.getElementById('cross');
  var line = g.querySelector('line'), dot = g.querySelector('circle');
  var tip  = document.getElementById('tip');
  if(!svg || !hit || !pts.length) return;

  function at(ev){
    var r = svg.getBoundingClientRect();
    var cx = ((ev.touches ? ev.touches[0].clientX : ev.clientX) - r.left) / r.width * {{ chart.w }};
    var best = 0, bd = Infinity;
    for (var i = 0; i < pts.length; i++){
      var d = Math.abs(pts[i][0] - cx);
      if (d < bd){ bd = d; best = i; }
    }
    var p = pts[best], row = data[best];
    line.setAttribute('x1', p[0]); line.setAttribute('x2', p[0]);
    dot.setAttribute('cx', p[0]); dot.setAttribute('cy', p[1]);
    dot.setAttribute('stroke', row[1] > 0 ? 'var(--up)' : 'var(--down)');
    g.setAttribute('opacity', 1);
    var sign = row[1] > 0 ? '+' : '';
    tip.textContent = row[0] + ' · ' + sign + (row[1]*100).toFixed(1) + '% · ' + (row[2] ? '{{ equal }}' : '{{ cap }}');
    tip.style.opacity = 1;
    var x = (ev.touches ? ev.touches[0].clientX : ev.clientX);
    var y = (ev.touches ? ev.touches[0].clientY : ev.clientY);
    tip.style.left = Math.min(x + 14, window.innerWidth - tip.offsetWidth - 10) + 'px';
    tip.style.top  = Math.max(y - 42, 8) + 'px';
  }
  function off(){ g.setAttribute('opacity', 0); tip.style.opacity = 0; }
  hit.addEventListener('mousemove', at);
  hit.addEventListener('mouseleave', off);
  hit.addEventListener('touchstart', at, {passive:true});
  hit.addEventListener('touchmove', at, {passive:true});
  hit.addEventListener('touchend', off);
})();
</script>
</body>
</html>
